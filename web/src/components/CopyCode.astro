---
import Icon from "./Icon.astro";
---

<!-- Adds a Copy button to every code block: both <Code> blocks and Markdown-rendered docs emit
     pre.astro-code. Each block is wrapped so the button stays put while the code scrolls sideways. -->
<template id="copy-code-button">
  <button class="copy-code" type="button" aria-label="Copy code" title="Copy">
    <span data-state="idle"><Icon name="copy" size={16} /></span>
    <span data-state="done" hidden><Icon name="check" size={16} /></span>
  </button>
</template>

<script>
  const template = document.querySelector<HTMLTemplateElement>("#copy-code-button");

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // No Clipboard API (e.g. plain http): fall back to a temporary selection.
      const area = document.createElement("textarea");
      area.value = text;
      area.style.cssText = "position:fixed;opacity:0";
      document.body.append(area);
      area.select();
      document.execCommand("copy");
      area.remove();
    }
  };

  for (const pre of document.querySelectorAll<HTMLPreElement>("pre.astro-code")) {
    if (!template || pre.parentElement?.classList.contains("code-block")) continue;
    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = (template.content.firstElementChild as HTMLButtonElement).cloneNode(true) as HTMLButtonElement;
    const [idle, done] = button.querySelectorAll<HTMLElement>("[data-state]");
    let timer: number | undefined;
    button.addEventListener("click", async () => {
      await copy((pre.textContent ?? "").replace(/\n+$/, ""));
      idle.hidden = true;
      done.hidden = false;
      button.setAttribute("aria-label", "Copied");
      button.title = "Copied";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        idle.hidden = false;
        done.hidden = true;
        button.setAttribute("aria-label", "Copy code");
        button.title = "Copy";
      }, 1500);
    });
    wrapper.append(button);
  }
</script>

<style is:global>
  .code-block {
    position: relative;
    margin: 1.25em 0;
  }
  .code-block > pre.astro-code {
    margin: 0;
    padding-right: 3rem;
  }
  .copy-code {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--panel);
    color: var(--text-muted);
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.15s, color 0.15s;
  }
  .code-block:hover .copy-code,
  .copy-code:focus-visible {
    opacity: 1;
  }
  .copy-code:hover {
    color: var(--heading);
  }
  .copy-code:has([data-state="done"]:not([hidden])) {
    color: var(--accent);
    opacity: 1;
  }
</style>

  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-sh": "^0.20.2"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write . && gofmt -w bridge && npm --prefix backend exec -- prisma format --schema backend/prisma/schema.prisma",
